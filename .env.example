# URL pública do site (usada em metadados, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://glassmaxi.com.br
# Google Analytics 4 (carregado somente após consentimento de cookies). Deixe vazio para desativar.
NEXT_PUBLIC_GA_ID=
# Código de verificação do Google Search Console (conteúdo da meta tag google-site-verification)
NEXT_PUBLIC_GSC_VERIFICATION=
# Endpoint opcional que recebe orçamentos/contatos em JSON (CRM, automação ou serviço de formulários).
# Sem ele, os formulários usam WhatsApp e e-mail. Nunca coloque chaves privadas em variáveis NEXT_PUBLIC_.
NEXT_PUBLIC_FORM_ENDPOINT=
# E-mail que recebe currículos (padrão: e-mail oficial de atendimento)
NEXT_PUBLIC_CAREERS_EMAIL=
